#!/bin/sh
# Blocks push if blog/*.html is stale relative to _template.html/posts-data.json/content/.
node scripts/build-blog.js > /dev/null

if ! git diff --quiet -- blog/*.html; then
    echo "error: blog/*.html is out of date with blog/_template.html, blog/posts-data.json, or blog/content/."
    echo "Run 'make blog' and commit the result before pushing."
    exit 1
fi
